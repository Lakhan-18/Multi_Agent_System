# CollaborAI - Environment Variables
# -------------------------------------------------------------
# Google Gemini API Key(s) (FREE through Google AI Studio - https://aistudio.google.com/app/apikey)
# Supports a single key OR a comma-separated key pool for automatic quota multiplication: "key1,key2,key3"
GEMINI_API_KEY="your_gemini_api_key_here"

# Model Selection (Gemini Free Tier default: gemini-3.5-flash-lite)
GEMINI_MODEL="gemini-3.5-flash-lite"

# Rate Limiter Configuration (Gemini Free Tier has a 15 RPM limit; 12 RPM ensures a safety cushion)
GEMINI_RATE_LIMIT_RPM=12

# Operational Mode (Set to true to use realistic deterministic mock agents for zero-quota / offline testing)
SIMULATION_MODE=false

# Database URL (SQLite async by default; easily replaced with postgresql+asyncpg://...)
DATABASE_URL="sqlite+aiosqlite:///./collaborai.db"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000
ENVIRONMENT="development"
